# ============================================================
# Caesar_Bot / Ichancy100 - Environment Variables Example
# ============================================================
# انسخ هذا الملف إلى .env محلياً، أو أضف القيم نفسها في Render > Environment.
# لا تضع القيم الحقيقية داخل GitHub العام.

# ------------------------------------------------------------
# Telegram Bot
# ------------------------------------------------------------
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN

# مشرف واحد أساسي
ADMIN_TELEGRAM_ID=YOUR_PERSONAL_TELEGRAM_ID

# اختياري: عدة مشرفين مفصولين بفواصل، مثال: 111,222,333
ADMIN_IDS=YOUR_PERSONAL_TELEGRAM_ID

# قنوات مراجعة الطلبات والسجلات - اختيارية لكنها موصى بها
# ضع chat_id للقناة/المجموعة، وغالباً يبدأ بـ -100
DEPOSIT_CHANNEL_ID=-100xxxxxxxxxx
WITHDRAWAL_CHANNEL_ID=-100xxxxxxxxxx
LOG_CHANNEL_ID=-100xxxxxxxxxx

# 🆕 قناة المسابقات والتوقعات - إشعارات المشاركات وأزرار القبول/الرفض
CONTEST_CHANNEL_ID=-100xxxxxxxxxx

# 🆕 إعدادات التقرير المالي اليومي
# ملاحظة: Render يستخدم UTC (غرينتش)
# الساعة 5 صباحاً UTC = الساعة 8 صباحاً بتوقيت سوريا (UTC+3)
DAILY_REPORT_HOUR=5
DAILY_REPORT_ENABLED=true

# 🆕 حد التنبيه لرصيد الكاشيرة (NSP) - سيتم تنبيهك عند النزول تحت هذا الحد
AGENT_BALANCE_ALERT_THRESHOLD=100000

# ------------------------------------------------------------
# Render / Webhook
# ------------------------------------------------------------
# رابط خدمة Render العام، مثال:
# https://your-service-name.onrender.com
RENDER_EXTERNAL_URL=https://your-service-name.onrender.com

# Render يضبط PORT تلقائياً عادة، لا تغيّره إلا إذا احتجت محلياً
PORT=8080

# ------------------------------------------------------------
# Database - Neon PostgreSQL
# ------------------------------------------------------------
# انسخ رابط الاتصال من Neon مع sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Neon Metrics (عرض الاستهلاك في لوحة المشرف — الخطة المجانية)
# احصل على مفتاح من: Neon Console > Account settings > API keys (يفضّل Read-Only)
NEON_API_KEY=your_neon_api_key_here
NEON_PROJECT_ID=your_project_id_here

# Render Monitoring (حالة الخدمة في لوحة المشرف)
# احصل على المفتاح من: Render Dashboard > Account Settings > API Keys
# و RENDER_SERVICE_ID من رابط لوحة الخدمة (srv-xxxxxxxx)
RENDER_API_KEY=your_render_api_key_here
RENDER_SERVICE_ID=srv-xxxxxxxxxxxxxxxxxxxx
# اختياري: فحص استيقاظ الخدمة (يوقظ الخدمة، لذا افتراضياً معطّل)
RENDER_ENABLE_PROBE=false

# ------------------------------------------------------------
# iChancy Agent API
# ------------------------------------------------------------
# بيانات دخول الوكيل لتجديد الجلسة تلقائياً
AGENT_USERNAME=YOUR_AGENT_USERNAME
AGENT_PASSWORD=YOUR_AGENT_PASSWORD

# Parent / Affiliate ID الخاص بالوكيل
PARENT_ID=YOUR_AGENT_PARENT_ID

# Agent ID المستخدم في تقارير الكاشيرة/الوكيل. غالباً هو نفسه Affiliate ID الظاهر في لوحة الوكيل.
AGENT_ID=YOUR_AGENT_ID

# رابط لوحة الوكيل. إذا كانت لوحة وكالتك على ichancy200 ضع الرابط التالي:
# ICHANCY_AGENT_BASE_URL=https://agents.ichancy200.com
ICHANCY_AGENT_BASE_URL=https://agents.ichancy100.com

# User-Agent للطلبات
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36

# ملاحظة:
# الكوكيز لم تعد ضرورية كمتغير بيئة دائم، يمكن تحديثها من لوحة الأدمن.
# ICHANCY_COOKIE=OPTIONAL_MANUAL_COOKIE_IF_NEEDED

# ------------------------------------------------------------
# Support
# ------------------------------------------------------------
SUPPORT_LINK=https://t.me/Caesar_Support
SUPPORT_USERNAME=@Caesar_Support

# روابط الموقع العامة - يمكن تغييرها من Render Environment
WEBSITE_URL=https://www.ichancy100.com
APP_DOWNLOAD_URL=https://www.ichancy100.com
BETTING_URL=https://facebook.com/your-bot-page
GAMES_URL=https://ichancy100.com/games

# ------------------------------------------------------------
# Payment Addresses / Numbers
# ------------------------------------------------------------
# يمكن وضع أكثر من رقم سيريتل بسطر جديد باستخدام \n
SYRIATEL_CASH_NUMBERS=83935571\n00229271
MTN_CASH_NUMBER=098xxxxxxx

SHAM_CASH_SYP_ADDRESS=SHAM-SYP-1092
SHAM_CASH_USD_ADDRESS=SHAM-USD-5093

USDT_TRC20_ADDRESS=TYxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
USDT_BEP20_ADDRESS=0xuxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------
# 🆕 حدود الإيداع والسحب الدنيا — قيم افتراضية احتياطية
# ------------------------------------------------------------
# هذه القيم تُدار فعلياً من لوحة Dashboard (قسم الأسعار والعمولات).
# القيم أدناه هي القيم الافتراضية فقط عند أول تشغيل.
# يمكنك تغييرها هنا إذا أردت بداية مختلفة، لكن الإدارة الفعلية من Dashboard.
MIN_DEPOSIT_SYP_DEFAULT=20000
MIN_DEPOSIT_USD_DEFAULT=5
MIN_WITHDRAW_SYP_DEFAULT=25000
MIN_WITHDRAW_USD_DEFAULT=10

# نسخة الليرة السورية المستخدمة في بوابات الدفع (old = قديمة, new = جديدة)
# الإدارة الفعلية من Dashboard → الأسعار والعمولات
SYP_VERSION=old

# ------------------------------------------------------------
# Legacy / Optional Defaults
# ------------------------------------------------------------
# الأسعار أصبحت تُدار من لوحة الأدمن وقاعدة البيانات.
# هذه القيم ليست المصدر الرئيسي بعد التحديثات الأخيرة، وتُترك فقط للتوافق.
EXCHANGE_RATE_BUY=87500
EXCHANGE_RATE_SELL=92500


# Syriatel Cash API auto verification
# Do NOT commit real token to GitHub. Put it in Render/VPS environment variables.
SYRIATEL_API_TOKEN=
# Phone number or secret code registered in the API dashboard
SYRIATEL_API_QUERY=
SYRIATEL_AUTO_VERIFY_ENABLED=true
SYRIATEL_AUTO_APPROVE_ENABLED=true

# Mini App can override these; useful as initial defaults
SYRIATEL_AUTO_MODE=off
SYRIATEL_AUTO_CHANNEL_ID=


# Free-tier / Neon optimization
# On Neon Free, frequent background DB writes keep compute awake and burn CU-hours.
WATCHDOG_ENABLED=true
WATCHDOG_INTERVAL_SECONDS=1800
WATCHDOG_AGENT_BALANCE_DB_UPDATE_SECONDS=3600
DB_POOL_MINCONN=1
DB_POOL_MAXCONN=5
DB_VALIDATE_CONNECTION=false
